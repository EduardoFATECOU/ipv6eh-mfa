[Unit]
Description=Auditor Agent Service (AA)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/ipv6eh-mfa
EnvironmentFile=-/etc/mfa/agent.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/ipv6eh-mfa/.venv/bin/python -m aa_agent
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
